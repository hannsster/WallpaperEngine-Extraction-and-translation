<UserControl x:Class="WallpaperStudio.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1040" d:DesignHeight="780">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wallpaper Library" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding CountsText}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding BrowseSourceCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="Choose folder" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                   Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="Scan library" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportAllCommand}" Content="Export approved" />
            </StackPanel>
        </Grid>

        <!-- =========================== Startup notice ======================== -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,14,0,0" Padding="14,12"
                Background="#1FF5C46B" BorderBrush="#4DF5C46B"
                Visibility="{Binding DataContext.HasStartupNotice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="16"
                           Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding DataContext.StartupNotice, RelativeSource={RelativeSource AncestorType=Window}}" Margin="11,0,12,0"
                           TextWrapping="Wrap" FontSize="12.5" Foreground="#F6E3BF" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        ToolTip="Dismiss" Command="{Binding DataContext.DismissStartupNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icon}" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ============================== Toolbar ============================ -->
        <Border Grid.Row="2" Style="{StaticResource RaisedCard}" Margin="0,14,0,0" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,26,0">
                    <TextBlock Text="SOURCE FOLDER" Style="{StaticResource Micro}" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource InsetCard}" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SourceFolderDisplay}" Margin="10,0,0,0"
                                           Style="{StaticResource MonoPath}" VerticalAlignment="Center"
                                           ToolTip="{Binding SourceFolder}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource SmallButton}" Content="Browse" Command="{Binding BrowseSourceCommand}" />
                            <Button Style="{StaticResource SmallButton}" Content="Open" Command="{Binding OpenSourceFolderCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EXPORTS" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ExportFolderDisplay}" Style="{StaticResource MonoPath}"
                                   Margin="10,0,10,0" VerticalAlignment="Center" ToolTip="{Binding ExportFolderDisplay}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open exports"
                                FontSize="11.5" Padding="8,4" Command="{Binding OpenExportFolderCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="200">
                    <CheckBox Style="{StaticResource Switch}" Content="Re-export everything"
                              IsChecked="{Binding ForceReExport}" />
                    <TextBlock Text="Ignores library memory for this batch." Style="{StaticResource Micro}"
                               Margin="53,4,0,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Clear current library"
                            HorizontalAlignment="Left" Padding="0,8,0,0" FontSize="11.5"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================== Stats + filters ====================== -->
        <Grid Grid.Row="3" Margin="0,16,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel VerticalAlignment="Center">
                <Border Style="{StaticResource InsetCard}" Padding="14,9" Margin="0,0,10,0" MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="{Binding DetectedCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Detected" Style="{StaticResource Micro}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsetCard}" Padding="14,9" Margin="0,0,10,0" MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="{Binding ReadyCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text="Ready" Style="{StaticResource Micro}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsetCard}" Padding="14,9" Margin="0,0,10,0" MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="{Binding NeedsReviewCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Warning}" />
                        <TextBlock Text="Need attention" Style="{StaticResource Micro}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsetCard}" Padding="14,9" Margin="0,0,10,0" MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="{Binding ExportedCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Text="Exported" Style="{StaticResource Micro}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsetCard}" Padding="14,9" MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="{Binding DuplicatesSkipped, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Text="Duplicates" Style="{StaticResource Micro}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <RadioButton Style="{StaticResource FilterPill}" GroupName="Filter" Content="All"
                                 IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="all" />
                    <RadioButton Style="{StaticResource FilterPill}" GroupName="Filter" Content="Ready"
                                 IsChecked="{Binding IsFilterReady, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="ready" />
                    <RadioButton Style="{StaticResource FilterPill}" GroupName="Filter" Content="Needs review"
                                 IsChecked="{Binding IsFilterReview, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="review" />
                    <RadioButton Style="{StaticResource FilterPill}" GroupName="Filter" Content="Exported"
                                 IsChecked="{Binding IsFilterExported, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="exported" />
                </StackPanel>
                <Grid Width="250">
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search title or path" FontSize="12" Margin="12,0,0,0"
                               Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ============================== Results ============================ -->
        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding WallpaperView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Width="292" Margin="0,0,14,14" Padding="11">
                                <StackPanel>
                                    <!-- Thumbnail -->
                                    <Border Height="150" CornerRadius="12" Background="#0E141F">
                                        <Grid>
                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Font.Icon}"
                                                       FontSize="34" Foreground="#33FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />

                                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8" Padding="7,3" Background="#99070A10" BorderBrush="#26FFFFFF">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Font.Icon}"
                                                               FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SourceTypeLabel}" Style="{StaticResource ChipText}"
                                                               Foreground="{StaticResource Brush.TextSecondary}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="8"
                                                    Background="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                                    BorderBrush="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource ChipText}"
                                                           Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                            </Border>

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                    CornerRadius="7" Background="#B3070A10" Padding="7,3">
                                                <TextBlock Text="{Binding ResolutionText}" FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="10.5" Foreground="#D7E1F2" />
                                            </Border>

                                            <ProgressBar Style="{StaticResource SlimProgressBar}" Height="3" VerticalAlignment="Bottom"
                                                         Margin="10,0,10,7" IsIndeterminate="True"
                                                         Visibility="{Binding IsThumbnailLoading, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Info -->
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" Margin="2,11,2,0"
                                               TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding MetadataSummary}" Style="{StaticResource Micro}" Margin="2,4,2,0" />

                                    <WrapPanel Margin="0,9,0,0">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                                BorderBrush="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}"
                                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="#1FF5C46B" BorderBrush="#40F5C46B"
                                                Visibility="{Binding UsesPreviewFallback, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Preview fallback" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource Brush.Warning}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="#1F63D6A6" BorderBrush="#4063D6A6"
                                                Visibility="{Binding IsExported, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="JPEG ready" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource Brush.Success}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="#1F6C9BFF" BorderBrush="#406C9BFF"
                                                Visibility="{Binding IsReverseSearching, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Finding original" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="#1F63D6A6" BorderBrush="#4063D6A6"
                                                ToolTip="A larger copy of this artwork was found by reverse image search."
                                                Visibility="{Binding HasBetterOriginal, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding OriginalChipText}" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource Brush.Success}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                ToolTip="The source of this artwork was identified, but no larger copy was found."
                                                Visibility="{Binding HasReverseMatches, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Source found" Style="{StaticResource ChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="{Binding ReverseResultsTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                                BorderBrush="{Binding ReverseResultsTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}"
                                                Visibility="{Binding ShowReverseStatusChip, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding ReverseResultsHeader}" Style="{StaticResource ChipText}"
                                                       Foreground="{Binding ReverseResultsTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Margin="2,2,2,0"
                                               Foreground="{StaticResource Brush.Danger}" MaxHeight="34"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                                               ToolTip="{Binding ErrorMessage}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SmallButton}" Content="Review frame"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.ReviewItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding RequiresApproval, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Export JPEG"
                                                Padding="12,7" FontSize="12"
                                                Command="{Binding DataContext.ExportItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanExportNow}" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                Margin="4,0,0,0" ToolTip="Look for the original artwork"
                                                Visibility="{Binding RequiresApproval, Converter={StaticResource InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.FindOriginalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Open"
                                                FontSize="11.5" Padding="6,7"
                                                Command="{Binding DataContext.OpenExportedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsExported, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                        Visibility="{Binding DetectedCount, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource Brush.AccentSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Font.Icon}" FontSize="26"
                               Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No wallpapers loaded yet" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Choose your Wallpaper Engine workshop folder, a project folder, or any folder of videos, images and .pkg scenes. Nothing is uploaded anywhere."
                           Style="{StaticResource PageSubtitle}" TextAlignment="Center" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Choose source folder" Command="{Binding BrowseSourceCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Scan now" Command="{Binding ScanCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
