<UserControl x:Class="WallpaperStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1040" d:DesignHeight="780">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Portable paths, export quality and safe tool discovery." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Reset defaults" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Save message -->
                <Border Style="{StaticResource InsetCard}" Padding="12,9" Margin="0,0,0,12"
                        Visibility="{Binding HasSaveMessage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                   Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SaveMessage}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== Left column ==================== -->
                    <StackPanel Margin="0,0,8,0">
                        <!-- Folders -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Folders" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="The source folder is scanned recursively. Exports never modify source files." Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                <TextBlock Text="SOURCE FOLDER" Style="{StaticResource Micro}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseSourceCommand}" />
                                </Grid>

                                <TextBlock Text="EXPORT FOLDER" Style="{StaticResource Micro}" Margin="0,12,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ExportFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseExportCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open" Padding="8,6" Margin="4,0,0,0" Command="{Binding OpenExportFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Export quality -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Export &amp; resolution" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="JPEGs preserve the approved frame's aspect ratio and are never upscaled." Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                <Grid>
                                    <TextBlock Text="JPEG QUALITY" Style="{StaticResource Micro}" />
                                    <TextBlock Text="{Binding JpegQuality, StringFormat={}{0}}" Style="{StaticResource Micro}"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Brush.Accent}" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="40" Maximum="100" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding JpegQuality, Mode=TwoWay}" />
                                <TextBlock Text="{Binding JpegQualityText}" Style="{StaticResource Micro}" Margin="0,2,0,0" />

                                <Border Style="{StaticResource Divider}" />

                                <CheckBox Style="{StaticResource Switch}" Content="Enforce the 1080p import rule"
                                          IsChecked="{Binding EnforceMinimumResolution}" />
                                <TextBlock Text="Long edge ≥ 1920 and short edge ≥ 1080. Portrait 1080×1920 passes; 1080×1080 and 1280×720 fail. Low-resolution imports still require your explicit approve or toss."
                                           Style="{StaticResource Micro}" Margin="53,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Video defaults -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Video defaults" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Used as the starting point when a video is opened for review. The real extraction always waits for approval." Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                <Grid>
                                    <TextBlock Text="DEFAULT FRAME TIME" Style="{StaticResource Micro}" />
                                    <TextBlock Text="{Binding DefaultFrameTimestampText}" Style="{StaticResource Micro}"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Brush.Accent}" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="60" TickFrequency="0.5"
                                        IsSnapToTickEnabled="True" Value="{Binding DefaultFrameTimestampSeconds, Mode=TwoWay}" />
                                <TextBlock Text="Try a later timestamp when the opening second is a logo or fade-in." Style="{StaticResource Micro}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== Right column ==================== -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <!-- Tooling -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Tool discovery" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Both tools are optional. No Steam credentials are read or stored." Style="{StaticResource Caption}" Margin="0,0,0,12" />
                                <TextBlock Text="FFMPEG (FOLDER OR EXE)" Style="{StaticResource Micro}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseFfmpegCommand}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                            Background="{Binding FfmpegTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                            BorderBrush="{Binding FfmpegTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                        <TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource ChipText}"
                                                   Foreground="{Binding FfmpegTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Detect" Command="{Binding DetectFfmpegCommand}" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <TextBlock Text="WALLPAPER ENGINE" Style="{StaticResource Micro}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding WallpaperEnginePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseWallpaperEngineCommand}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                            Background="{Binding WallpaperEngineTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                            BorderBrush="{Binding WallpaperEngineTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                        <TextBlock Text="{Binding WallpaperEngineStatus}" Style="{StaticResource ChipText}"
                                                   Foreground="{Binding WallpaperEngineTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Detect" Command="{Binding DetectWallpaperEngineCommand}" />
                                </Grid>

                                <TextBlock Text="FFmpeg is licensed separately (typically LGPL/GPL depending on the build). If you redistribute it, include its license and source offer. Wallpaper Studio never bundles or downloads it."
                                           Style="{StaticResource Micro}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Workshop publishing -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE72D;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Workshop publishing" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Optional. Uploading uses Valve's SteamCMD and is private by default. Steam passwords and Steam Guard codes are never entered or stored here." Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                <TextBlock Text="STEAMCMD (STEAMCMD.EXE)" Style="{StaticResource Micro}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SteamCmdPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseSteamCmdCommand}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                            Background="{Binding SteamCmdTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                            BorderBrush="{Binding SteamCmdTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                        <TextBlock Text="{Binding SteamCmdStatus}" Style="{StaticResource ChipText}"
                                                   Foreground="{Binding SteamCmdTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Detect" Command="{Binding DetectSteamCmdCommand}" />
                                </Grid>

                                <TextBlock Text="STEAM ACCOUNT NAME" Style="{StaticResource Micro}" Margin="0,12,0,0" />
                                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,0"
                                         Text="{Binding SteamUsername, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Only the account name. Never enter your password here." />
                                <TextBlock Text="Just the account name, so uploads can reuse the SteamCMD session you created with Sign in. Wallpaper Studio has no password field by design."
                                           Style="{StaticResource Micro}" Margin="0,6,0,0" />

                                <TextBlock Text="SteamCMD and Steam are Valve's tools and are distributed by Valve under Valve's terms. Wallpaper Studio never bundles or downloads them, and only uploads items you explicitly publish."
                                           Style="{StaticResource Micro}" Margin="0,11,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Behaviour -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Skip unchanged exports" IsChecked="{Binding SkipAlreadyExported}" />
                                <TextBlock Text="A source is skipped only when its fingerprint and last-modified time still match. The per-batch override in the library can force a re-export."
                                           Style="{StaticResource Micro}" Margin="53,5,0,12" />
                                <CheckBox Style="{StaticResource Switch}" Content="Auto-approve extracted scene frames" IsChecked="{Binding AutoApproveScenes}" />
                                <TextBlock Text="Scenes that resolve to full resolution are exported without a manual step. Scenes below 1080p, frames that come out nearly all black, and every video still need your approval."
                                           Style="{StaticResource Micro}" Margin="53,5,0,12" />
                                <CheckBox Style="{StaticResource Switch}" Content="Open export folder after a batch" IsChecked="{Binding OpenExportFolderAfterBatch}" />
                                <TextBlock Text="Useful when you want to copy the JPEGs to a tablet immediately."
                                           Style="{StaticResource Micro}" Margin="53,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Storage -->
                        <Border Style="{StaticResource RaisedCard}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Portable storage" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" />
                                </StackPanel>

                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                        Background="{Binding PortableTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                        BorderBrush="{Binding PortableTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                    <TextBlock Text="{Binding PortableModeText}" Style="{StaticResource ChipText}"
                                               Foreground="{Binding PortableTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                </Border>

                                <TextBlock Text="DATA FOLDER" Style="{StaticResource Micro}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MonoPath}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="STATE FILE" Style="{StaticResource Micro}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding StateFile}" Style="{StaticResource MonoPath}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding StateRecordCount, StringFormat={}{0:N0} remembered sources}" Style="{StaticResource Micro}" Margin="0,4,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SmallButton}" Content="Open state file" Command="{Binding OpenStateFolderCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SmallButton}" Content="Open logs" Command="{Binding OpenLogFolderCommand}" />
                                </StackPanel>

                                <TextBlock Text="Wallpaper Studio only reads local wallpaper files you select. It stays offline until you press Publish on the Workshop screen, which runs Valve's own SteamCMD."
                                           Style="{StaticResource Micro}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Personal use only. Respect the rights of wallpaper creators; do not publish content you do not own or license."
                           Style="{StaticResource Micro}" HorizontalAlignment="Center" Margin="0,6,0,10" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
