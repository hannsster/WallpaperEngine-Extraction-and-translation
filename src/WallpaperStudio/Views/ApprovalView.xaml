<UserControl x:Class="WallpaperStudio.Views.ApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1040" d:DesignHeight="780">

    <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding HasItem, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource Brush.AccentSoft}"
                    HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Font.Icon}" FontSize="26"
                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Nothing to review" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Choose a video, scene or workshop wallpaper in the library and select Review frame. You will always see the exact frame before it is exported."
                       Style="{StaticResource PageSubtitle}" TextAlignment="Center" Margin="0,8,0,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="Back to library" HorizontalAlignment="Center"
                    Margin="0,18,0,0" Command="{Binding BackCommand}" />
        </StackPanel>

        <Grid Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" ToolTip="Back to library"
                        Command="{Binding BackCommand}" Margin="0,2,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Font.Icon}" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"
                               MaxWidth="640" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MetadataSummary}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Open source location"
                            Command="{Binding OpenFileLocationCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Open exports"
                            Command="{Binding OpenExportFolderCommand}" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="384" />
                </Grid.ColumnDefinitions>

                <!-- Preview -->
                <Border Style="{StaticResource RaisedCard}" Padding="14" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="EXPORT CANDIDATE" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Chip}"
                                    Background="#1A6C9BFF" BorderBrush="#33FFFFFF">
                                <TextBlock Text="{Binding CandidateSourceLabel}" Style="{StaticResource ChipText}"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" CornerRadius="14" Background="#080B11" MinHeight="380"
                                BorderBrush="{StaticResource Brush.BorderFaint}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PreviewImage}" Stretch="Uniform" />
                                    </Border.Background>
                                </Border>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Font.Icon}" FontSize="38"
                                               Foreground="#3DFFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="No frame selected" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Text="Extract a video frame or scene image, or choose an image manually."
                                               Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Busy overlay -->
                                <Border Background="#B3070A10" CornerRadius="14"
                                        Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                                        <ProgressBar Style="{StaticResource SlimProgressBar}" IsIndeterminate="True" />
                                        <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Caption}"
                                                   TextAlignment="Center" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding PreviewPathDisplay}" Style="{StaticResource MonoPath}"
                                   Margin="2,10,2,0" />
                    </Grid>
                </Border>

                <!-- Details -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,14,16">
                        <StackPanel>
                            <!-- Fallback notice -->
                            <Border Style="{StaticResource InsetCard}" Padding="13,11" Margin="0,0,0,12"
                                    Background="#1FF5C46B" BorderBrush="#4DF5C46B"
                                    Visibility="{Binding HasFallbackNotice, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                                        <TextBlock Text="Preview / fallback" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Warning}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FallbackNotice}" Style="{StaticResource Caption}"
                                               Foreground="#F1DDB6" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Generic notice -->
                            <Border Style="{StaticResource InsetCard}" Padding="13,11" Margin="0,0,0,12"
                                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="Heads up" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SOURCE" Style="{StaticResource Micro}" />
                            <Border Style="{StaticResource InsetCard}" Padding="11,9" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MonoPath}"
                                               TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Text="{Binding ResolutionDetail}" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Video frame picker -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="FRAME TIMESTAMP" Style="{StaticResource Micro}" />
                                    <TextBlock Text="{Binding FrameTimestampText}" Style="{StaticResource Micro}"
                                               HorizontalAlignment="Right" Foreground="{StaticResource Brush.Accent}" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}" Margin="0,8,0,0"
                                        Minimum="0" Maximum="{Binding MaxTimestamp}"
                                        Value="{Binding FrameTimestamp, Mode=TwoWay}"
                                        IsEnabled="{Binding CanScrub}" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="00:00" Style="{StaticResource Micro}" />
                                    <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource TubeTime}}"
                                               Style="{StaticResource Micro}" HorizontalAlignment="Right" />
                                </Grid>
                                <Button Style="{StaticResource SecondaryButton}" Content="Regenerate frame at this time"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding RegenerateCommand}" />
                                <TextBlock Text="FFmpeg not found. Set its folder in Settings to extract video frames."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Brush.Warning}"
                                           Margin="0,7,0,0"
                                           Visibility="{Binding HasFfmpeg, Converter={StaticResource InverseBoolToVisibility}}" />

                                <Border Style="{StaticResource Divider}" Margin="0,13,0,0" />

                                <Grid>
                                    <TextBlock Text="FIND A BETTER FRAME" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource GhostButton}" Content="Sample frames"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            FontSize="11.5" Padding="9,5"
                                            Command="{Binding ScanFramesCommand}" />
                                </Grid>
                                <TextBlock Text="If the video opens on a fade, logo or black screen, sample it and pick the moment where the artwork is fully visible. The clearest frame is selected for you."
                                           Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" />

                                <ProgressBar Style="{StaticResource SlimProgressBar}" IsIndeterminate="True" Margin="0,9,0,0"
                                             Visibility="{Binding IsSampling, Converter={StaticResource BoolToVisibility}}" />

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Margin="0,9,0,0"
                                              Visibility="{Binding HasFrameSamples, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding FrameSamples}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FilmstripButton}"
                                                        ToolTip="{Binding Label}"
                                                        Command="{Binding DataContext.PickSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <Border Height="44" CornerRadius="8,8,0,0">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <Border Background="#66070A10" CornerRadius="0,0,8,8" Padding="3,2">
                                                            <TextBlock Text="{Binding Label}" FontSize="9.5" HorizontalAlignment="Center"
                                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="{Binding FrameSamplesSummary}" Style="{StaticResource Micro}" Margin="0,5,0,0"
                                           Visibility="{Binding HasFrameSamples, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Scene tools -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsScene, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="SCENE IMAGE" Style="{StaticResource Micro}" />
                                <TextBlock Text="Full-resolution images are decoded from the package's texture files and stacked into one frame. A low-resolution project preview is offered only if extraction is not possible."
                                           Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Re-extract scene image"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Command="{Binding ScanEmbeddedCommand}" />
                            </StackPanel>

                            <!-- Original artwork (reverse image search) -->
                            <Border Style="{StaticResource Divider}" />

                            <Grid>
                                <TextBlock Text="ORIGINAL ARTWORK" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReverseProviderSummary}" Style="{StaticResource Micro}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                                           ToolTip="Providers used for reverse image search" />
                            </Grid>

                            <!-- Consent prompt -->
                            <Border Style="{StaticResource InsetCard}" Padding="13,11" Margin="0,8,0,0"
                                    Background="#1F6C9BFF" BorderBrush="#406C9BFF"
                                    Visibility="{Binding ReverseConsentMissing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Search the web for this artwork?" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ReverseConsentText}" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource SmallButton}" Content="Turn on reverse image search"
                                            HorizontalAlignment="Left" Margin="0,9,0,0"
                                            Command="{Binding EnableReverseSearchCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Enabled but no usable provider -->
                            <Border Style="{StaticResource InsetCard}" Padding="13,11" Margin="0,8,0,0"
                                    Background="#1FF5C46B" BorderBrush="#4DF5C46B"
                                    Visibility="{Binding ReverseNotConfigured, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                                        <TextBlock Text="No provider is ready yet" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Warning}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Enable trace.moe (no key needed) or add a free SauceNAO / Google Vision API key in Settings, then search again."
                                               Style="{StaticResource Caption}" Foreground="#F1DDB6"
                                               Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ProgressBar Style="{StaticResource SlimProgressBar}" IsIndeterminate="True" Margin="0,9,0,0"
                                         Visibility="{Binding Item.IsReverseSearching, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding Item.ReverseResultsHeader}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{Binding Item.ReverseResultsTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}"
                                       Visibility="{Binding Item.ShowReverseStatus, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding Item.ReverseNote}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Item.HasReverseNote, Converter={StaticResource BoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding Item.ReverseResults}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCard}" Padding="9" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="64" Height="64" CornerRadius="9" Background="#0E141F"
                                                        VerticalAlignment="Top">
                                                    <Grid>
                                                        <Border CornerRadius="9">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                                                                   Foreground="#3DFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                    <TextBlock Text="{Binding Subheader}" Style="{StaticResource Micro}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Border Style="{StaticResource Chip}" Padding="6,2" Margin="0,0,5,0"
                                                                Background="{Binding SizeTone, Converter={StaticResource ToneBrush}, ConverterParameter=background}"
                                                                BorderBrush="{Binding SizeTone, Converter={StaticResource ToneBrush}, ConverterParameter=border}">
                                                            <TextBlock Text="{Binding SizeBadge}" Style="{StaticResource ChipText}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding SizeTone, Converter={StaticResource ToneBrush}, ConverterParameter=foreground}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Padding="6,2" Margin="0,0,5,0"
                                                                Background="#14FFFFFF" BorderBrush="#26FFFFFF">
                                                            <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource ChipText}" FontSize="10"
                                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Padding="6,2"
                                                                Background="#14FFFFFF" BorderBrush="#26FFFFFF">
                                                            <TextBlock Text="{Binding SimilarityText}" Style="{StaticResource ChipText}" FontSize="10"
                                                                       Foreground="{StaticResource Brush.TextPrimary}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Style="{StaticResource SmallButton}" Content="Open page"
                                                                FontSize="11" Padding="8,4"
                                                                Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Style="{StaticResource SmallButton}" Content="Use image"
                                                                FontSize="11" Padding="8,4" Margin="6,0,0,0"
                                                                ToolTip="Download this image and make it the export candidate"
                                                                Command="{Binding DataContext.UseResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanUseImage, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SmallButton}" Content="Search again" HorizontalAlignment="Left"
                                    Margin="0,2,0,0"
                                    Command="{Binding SearchOriginalCommand}"
                                    Visibility="{Binding ReverseReady, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="Only a 1280-pixel copy of this frame is uploaded. Nothing is downloaded unless you choose a match, and every result stays a suggestion until you approve it."
                                       Style="{StaticResource Micro}" Margin="0,9,0,0" TextWrapping="Wrap" />

                            <Border Style="{StaticResource Divider}" />

                            <!-- Actions -->
                            <StackPanel>
                                <TextBlock Text="DECISION" Style="{StaticResource Micro}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ApprovalStatusLabel}" Style="{StaticResource Caption}" Margin="0,0,0,10"
                                           Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Approve this frame"
                                            Command="{Binding ApproveCommand}" HorizontalContentAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Toss"
                                            Margin="8,0,0,0" Command="{Binding TossCommand}" />
                                </Grid>
                                <TextBlock Text="This image is already usable, so there is nothing to approve. Choosing a match below replaces the candidate and asks you to confirm it first."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="{Binding NeedsDecision, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Choose a different image…"
                                        Margin="0,8,0,0" Command="{Binding ChooseImageCommand}" />
                                <TextBlock Text="Approved frames are exported as high-quality JPEGs. Videos and scenes are never exported without this step."
                                           Style="{StaticResource Micro}" Margin="0,10,0,0"
                                           Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
