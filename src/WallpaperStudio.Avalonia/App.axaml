<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WallpaperStudio.ViewModels"
             xmlns:views="using:WallpaperStudio.Views"
             xmlns:conv="using:WallpaperStudio.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="WallpaperStudio.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:IsNullConverter x:Key="IsNull" />
    <conv:CountToBoolConverter x:Key="CountToBool" />
    <conv:ToneBrushConverter x:Key="ToneBrush" />
    <conv:JpegImageConverter x:Key="JpegImage" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <mi:MaterialIconStyles />
    <StyleInclude Source="avares://WallpaperStudio/Themes/Theme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="vm:ApprovalViewModel">
      <views:ApprovalView />
    </DataTemplate>
    <DataTemplate DataType="vm:ImportViewModel">
      <views:ImportView />
    </DataTemplate>
    <DataTemplate DataType="vm:PublishViewModel">
      <views:PublishView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
