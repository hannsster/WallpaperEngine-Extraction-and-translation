<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="WallpaperStudio.Views.Dialogs.MessageDialog"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        Title="Wallpaper Studio">

  <Border Margin="18" CornerRadius="20" Background="#F7141B28"
          BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1"
          BoxShadow="0 12 40 0 #73000000">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="22,18,22,20">

      <Grid ColumnDefinitions="Auto,*" PointerPressed="Header_PointerPressed">
        <Border Name="IconPlate" Width="34" Height="34" CornerRadius="10" Background="#1F6C9BFF">
          <mi:MaterialIcon Name="KindIcon" Kind="Information" Width="17" Height="17"
                           Foreground="{StaticResource Brush.Accent}"
                           HorizontalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Wallpaper Studio" Classes="micro" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" MaxHeight="360" Margin="0,16,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{StaticResource Brush.TextSecondary}" />
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="0,20,0,0" Spacing="8">
        <Button Name="SecondaryButton" Classes="secondary" IsVisible="False" />
        <Button Name="PrimaryButton" Classes="primary" Content="OK" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
